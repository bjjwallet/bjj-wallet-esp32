+    assert.equal(scriptFor(tx.toAddress),tx.recipientScript);assert.equal(scriptFor(tx.changeAddress),tx.changeScript);
+    assert(Array.isArray(tx.utxos)&&tx.utxos.length>0&&tx.utxos.length<=16);
+    let total=0n;const seen=new Set();
+    for(const input of tx.utxos) {
+        assert.equal(input.sequence,4294967295);assert(Number.isInteger(input.index)&&input.index>=0&&input.index<=4294967295);
+        assert(/^[0-9a-f]{64}$/.test(input.txHash));const key=input.txHash+':'+input.index;assert(!seen.has(key));seen.add(key);
+        const value=quantity(input.amount);assert(value>0n);total+=value;assert(total<=9000000000000000n);
+        assert.equal(input.script,tx.changeScript);
+        const parent=parseTransaction(input.previousTransaction);assert.equal(parent.txid,input.txHash);
+        assert(parent.outputs[input.index]);assert.equal(parent.outputs[input.index].amount,value);assert.equal(parent.outputs[input.index].script,input.script);
+    }
