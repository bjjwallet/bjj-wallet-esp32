+    auto session=std::make_unique<UnlockSession>();
+    xSemaphoreTake(mutex_,portMAX_DELAY);
+    if (busy_ || !signing_session_ || !signing_session_->authorized) { xSemaphoreGive(mutex_); return false; }
+    session->pin_key.value=signing_session_->pin_key.value;session->authorized=true;
+    const auto index=active_wallet_.load(); const auto epoch=authorization_epoch_.load();
+    busy_=true; xSemaphoreGive(mutex_);
+    UtxoReview review; crypto::Entropy entropy; Credential pass,words; crypto::Seed seed;
+    bool ok=review_utxo(payload,review) && vault_.recover(*session,phrase,entropy,pass,index)==VaultError::None &&
+        crypto::mnemonic_from_entropy({entropy.data.value.data(),entropy.size},words)==crypto::HdError::None &&
+        crypto::wallet_core_seed(words.view(),review.mode=="HIDDEN"?pass.view():std::string_view{},seed)==crypto::HdError::None &&
+        sign_utxo(payload,{seed.value.data(),seed.value.size()},signing_random_,encoded);
+    session.reset();
+    xSemaphoreTake(mutex_,portMAX_DELAY);busy_=false;
+    ok=ok && signing_session_ && signing_session_->authorized && epoch==authorization_epoch_ && index==active_wallet_;
+    xSemaphoreGive(mutex_);
+    if (!ok) encoded.clear();
+    return ok;
