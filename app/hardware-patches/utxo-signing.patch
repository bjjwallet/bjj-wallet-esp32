+std::string NimbleDeviceService::request_signature(std::string_view payload,std::uint64_t connection,std::string& error) {
+    auto& state=*state_; std::vector<std::pair<std::string,std::string>> fields;
+    error="INVALID_UTXO_PLAN";
+    if (!state.wallet.review_signing(payload,fields)) return {};
+    using Json=std::unique_ptr<cJSON,decltype(&cJSON_Delete)>;
+    Json object(parse_json(payload),cJSON_Delete);if(!object)return {};
+    auto* password=cJSON_GetObjectItemCaseSensitive(object.get(),"password");
+    if(!cJSON_IsString(password)||!password->valuestring||std::strlen(password->valuestring)>1024)return {};
+    TransactionPrompt prompt;prompt.request.connection=connection;
+    if(!prompt.request.password.assign(password->valuestring))return {};
+    wipe(password->valuestring,std::strlen(password->valuestring));cJSON_DeleteItemFromObjectCaseSensitive(object.get(),"password");
+    char* raw=cJSON_PrintUnformatted(object.get());if(!raw)return {};
+    const bool assigned=prompt.request.payload.assign(raw,180000);json_free(raw);if(!assigned)return {};
+    for(auto&field:fields)prompt.request.review.push_back({field.first,field.second});
+    {
+        std::lock_guard<std::mutex> lock(state.mutex);
+        if(state.signing_connection){error="SIGNING_BUSY";return {};}
+        state.signing_connection=connection;state.transaction_prompt.emplace(std::move(prompt));
+    }
+    const auto started=now_ms(), epoch=state.wallet.public_authorization_epoch();
+    std::string encoded;
+    while(now_ms()-started<180000&&!state.stopping) {
+        const auto peer=state.current();
+        if(!peer.connected||peer.connection!=connection||!peer.authenticated||!peer.encrypted||epoch!=state.wallet.public_authorization_epoch()){error="DEVICE_DISCONNECTED";break;}
+        std::optional<SigningJob> job;
+        {
+            std::lock_guard<std::mutex>lock(state.mutex);
+            if(state.signing_outcome){
+                auto outcome=std::move(*state.signing_outcome);state.signing_outcome.reset();
+                if(outcome.connection==connection&&outcome.reason==SignEnd::Completed)encoded=std::move(outcome.encoded);
+                else error="TRANSACTION_REJECTED";
+                break;
+            }
+            if(state.signing_job){job.emplace(std::move(*state.signing_job));state.signing_job.reset();}
+        }
+        if(job){
+            SigningResult result{job->token,connection,{},{},false};
+            result.success=state.wallet.sign_transaction(job->request.payload.view(),job->request.password.view(),result.encoded);
+            job.reset();if(!result.success)result.error="SIGNING_FAILED";
+            std::lock_guard<std::mutex>lock(state.mutex);state.signing_result.emplace(std::move(result));
+        } else vTaskDelay(pdMS_TO_TICKS(20));
+    }
+    {
+        std::lock_guard<std::mutex>lock(state.mutex);
+        state.transaction_prompt.reset();state.signing_job.reset();state.signing_result.reset();state.signing_outcome.reset();state.signing_connection=0;
+    }
+    return encoded;
+}
+std::optional<TransactionPrompt> NimbleDeviceService::poll_transaction(){
+    std::lock_guard<std::mutex>lock(state_->mutex);auto value=std::move(state_->transaction_prompt);state_->transaction_prompt.reset();return value;
+}
+bool NimbleDeviceService::sign(SigningJob job){
+    std::lock_guard<std::mutex>lock(state_->mutex);
+    if(state_->signing_connection!=job.request.connection||state_->signing_job)return false;
+    state_->signing_job.emplace(std::move(job));return true;
+}
+std::optional<SigningResult> NimbleDeviceService::poll_signature(){
+    std::lock_guard<std::mutex>lock(state_->mutex);auto value=std::move(state_->signing_result);state_->signing_result.reset();return value;
+}
+void NimbleDeviceService::respond_transaction(SignOutcome outcome,std::string_view){
+    std::lock_guard<std::mutex>lock(state_->mutex);
+    if(state_->signing_connection==outcome.connection)state_->signing_outcome.emplace(std::move(outcome));
