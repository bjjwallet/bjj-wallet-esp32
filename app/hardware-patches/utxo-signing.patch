+    le(b,0,4);return b;
+}
+}
+bool review_utxo(std::string_view payload,UtxoReview&review){Plan p;if(!parse(payload,p))return false;review=std::move(p.review);return true;}
+bool sign_utxo(std::string_view payload,crypto::Bytes seed,crypto::RandomSource&random,std::string&encoded){
