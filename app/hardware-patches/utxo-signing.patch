+}
+function validatePlan(core, coinType, tx) {
+    assert.equal(tx.utxoVersion,1);assert.equal(tx.useMax,false);
+    const amount=quantity(tx.amount),fee=quantity(tx.fee),change=quantity(tx.changeAmount),rate=quantity(tx.byteFee);
+    assert(amount>0n&&fee>0n&&rate>0n&&rate<=10000000n);
+    assert.notEqual(tx.toAddress,tx.changeAddress);
