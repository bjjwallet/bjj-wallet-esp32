+        if(value.size()<9)value.insert(0,9-value.size(),'0');
+        value.insert(value.size()-8,1,'.');while(value.back()=='0')value.pop_back();
+        if(value.back()=='.')value.pop_back();
+        return value+" "+review.symbol;
+    };
+    fields={{"Rede",review.coin},{"Destino",review.recipient},{"Valor",display(review.amount)},
+        {"Taxa",display(review.fee)},{"Troco",display(review.change)},{"Endereço de troco",review.address}};
+    return true;
+}
+bool BoardSetupService::sign_transaction(std::string_view payload,std::string_view phrase,std::string& encoded) {
