+    for(let i=0;i<count;i++) inputs.push({hash:take(32).toString('hex'),index:Number(read(4)),script:script(),sequence:Number(read(4))});
+    const inputEnd=pos;const outputStart=pos;const outputCount=compact();assert(outputCount>0&&outputCount<=10000);const outputs=[];
+    for(let i=0;i<outputCount;i++)outputs.push({amount:read(8),script:script().toString('hex')});
+    const outputEnd=pos;const witnesses=[];
+    if(witness)for(let i=0;i<count;i++){const n=compact();assert(n<=10000);const stack=[];for(let j=0;j<n;j++)stack.push(script());witnesses.push(stack);}
