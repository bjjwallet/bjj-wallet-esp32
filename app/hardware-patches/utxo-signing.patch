+        if(wpkh(p.change)||type==0x41){Bytes points,sequences;for(auto&in:p.inputs){outpoint(points,in);le(sequences,0xffffffff,4);}Bytes pre;le(pre,2,4);append(pre,hash(points));append(pre,hash(sequences));outpoint(pre,p.inputs[i]);script(pre,code);le(pre,p.inputs[i].amount,8);le(pre,0xffffffff,4);append(pre,hash(outputs(p)));le(pre,0,4);le(pre,type,4);digest=hash(pre);}
+        else{std::vector<Bytes>unsigned_scripts(p.inputs.size());unsigned_scripts[i]=code;auto pre=transaction(p,unsigned_scripts,{},{});le(pre,type,4);digest=hash(pre);}
+        if(digest.size()!=32)return false;
