+    const expected=[{amount:quantity(tx.amount),script:tx.recipientScript}];if(quantity(tx.changeAmount)>0n)expected.push({amount:quantity(tx.changeAmount),script:tx.changeScript});
+    const order = (a,b) => a.script.localeCompare(b.script);
+    assert.deepEqual(result.outputs.sort(order),expected.sort(order));
+}
