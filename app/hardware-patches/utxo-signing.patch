+    encoded.clear();Plan p;if(!parse(payload,p))return false;crypto::DerivedKey key;
+    if(crypto::derive_key(seed,crypto::Curve::Secp256k1,p.review.path,random,key)!=crypto::HdError::None)return false;
+    AccountPublicKey public_key{key.public_key,key.public_key_size};std::string source;
+    if(encode_receiving_address(p.review.network,public_key,source)!=crypto::HdError::None||source!=p.review.address)return false;
