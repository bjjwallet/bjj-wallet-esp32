+        std::array<std::uint8_t,72>der{};auto size=ecdsa_sig_to_der(signature.value.data(),der.data());if(size<8||size>72)return false;Bytes sig(der.begin(),der.begin()+size);sig.push_back(type);signatures.push_back(sig);
+        if(!wpkh(p.change)){scripts[i].push_back(sig.size());append(scripts[i],sig);scripts[i].push_back(pub.size());append(scripts[i],pub);}
+    }
+    encoded=hex(transaction(p,scripts,signatures,pub));return !encoded.empty();
+}
+}
